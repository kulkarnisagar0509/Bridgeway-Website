# Bridgeway server configuration — copy to .env and fill in real values.
# Never commit the real .env.

# System-level SMTP account used to send form submissions.
# Gmail example: create an App Password (Google Account > Security >
# 2-Step Verification > App passwords) and paste it WITHOUT spaces.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# 587 = STARTTLS → false. Use true only for implicit SMTPS on port 465.
SMTP_SECURE=false
SMTP_USER=your.address@gmail.com
SMTP_PASS=
# "From:" header, e.g. "Bridgeway Website <info@bridgewayz.ca>"
SMTP_FROM=

# Where form submissions are delivered (defaults to SMTP_USER if unset).
FORMS_TO_EMAIL=info@bridgewayz.ca

# Port the Express server listens on (Vite proxies /api here in dev).
PORT=3001
# Stripe (payment page at /payment). Use test keys (sk_test_/pk_test_) first.
# The secret key stays on the server only — never expose it to the frontend.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# ISO currency code for payments (default: cad)
STRIPE_CURRENCY=cad
